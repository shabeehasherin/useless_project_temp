{
  "name": "vscode-battery-analyzer",
  "displayName": "Battery Percentage Over-Analyzer",
  "description": "Reads your system battery % and provides hilarious, deep, unnecessary existential insights, status bar indicators, and interactive webview dashboards.",
  "version": "1.0.0",
  "publisher": "battery-over-analyzer",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "batteryAnalyzer.analyze",
        "title": "Battery: Analyze System Battery Level",
        "icon": "$(zap)"
      },
      {
        "command": "batteryAnalyzer.quickInsight",
        "title": "Battery: Show Quick Existential Insight",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "batteryAnalyzer.openDashboard",
        "title": "Battery: Open Interactive Over-Analysis Dashboard",
        "icon": "$(dashboard)"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Battery Over-Analyzer",
      "properties": {
        "batteryAnalyzer.refreshInterval": {
          "type": "number",
          "default": 30,
          "description": "Interval in seconds to check battery status and update the VS Code status bar."
        },
        "batteryAnalyzer.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show battery status and over-analysis tooltip in the VS Code status bar."
        },
        "batteryAnalyzer.enableSoundEffects": {
          "type": "boolean",
          "default": true,
          "description": "Enable sound effects in the Over-Analysis Dashboard webview."
        }
      }
    }
  },
  "scripts": {
    "start": "node cli.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0"
  }
}
